{
  "manifest_version": 3,
  "name": "Joystick Universal Controller",
  "version": "15.2",
  "description": "Accessible browser and webpage controller for joysticks and gamepads. Move the cursor, click, fill forms, scroll, and switch tabs.",
  "permissions": [
    "tabs",
    "offscreen",
    "storage",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
